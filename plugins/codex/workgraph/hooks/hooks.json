{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "intelliforge hook --agent codex recall"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "intelliforge hook --agent codex save"
          }
        ]
      }
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-intelliforge.local/ux-contract-v1",
  "title": "UX design contract v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "journeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/journey"
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screen"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "presented",
            "approved",
            "needs_review",
            "delegated"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status"
      ]
    }
  },
  "required": [
    "schema_version",
    "revision",
    "project",
    "journeys",
    "screens",
    "actions",
    "transitions",
    "requirements",
    "artifacts",
    "approval"
  ],
  "$defs": {
    "state": {
      "type": "object",
      "properties": {
        "screen_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "screen_id",
        "state"
      ]
    },
    "locator": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "selector"
          ]
        },
        {
          "required": [
            "role",
            "name"
          ]
        }
      ]
    },
    "journey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "purpose",
        "actions",
        "required"
      ]
    },
    "screen": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "pattern": "^/[^\\\\]*$"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "component": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path"
          ]
        },
        "layout": {
          "type": "object"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "text",
                  "search",
                  "email",
                  "number",
                  "textarea",
                  "select",
                  "checkbox"
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "locator": {
                "$ref": "#/$defs/locator"
              }
            },
            "required": [
              "id",
              "label"
            ]
          }
        },
        "state_messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "title",
        "purpose",
        "route",
        "states",
        "component"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "screen_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "click",
            "fill",
            "select",
            "press"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      },
      "required": [
        "id",
        "screen_id",
        "label",
        "kind",
        "locator"
      ]
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "from": {
          "$ref": "#/$defs/state"
        },
        "to": {
          "$ref": "#/$defs/state"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "on_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/state"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "action_id",
        "from",
        "to",
        "condition",
        "on_error",
        "retained_fields"
      ]
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "screen_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "type": {
          "enum": [
            "visible",
            "text",
            "value",
            "checked",
            "focused",
            "accessible_name",
            "url"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "expected": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        }
      },
      "required": [
        "id",
        "screen_id",
        "state",
        "type",
        "expected"
      ]
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "journey_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        }
      },
      "required": [
        "id",
        "journey_id",
        "required",
        "acceptance"
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "provider": {
          "enum": [
            "local",
            "figma",
            "whimsical"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "file_id": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "id",
        "provider",
        "url",
        "file_id",
        "bindings"
      ]
    }
  }
}

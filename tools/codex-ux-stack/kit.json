{
  "schema_version": 1,
  "id": "ux-stack",
  "name": "UX Stack",
  "version": "1.2.0",
  "legacy": {
    "script": "install_codex_ux_stack.sh",
    "actions": {
      "install": [],
      "update": [
        "--update"
      ],
      "doctor": [
        "--doctor"
      ],
      "uninstall": [
        "--uninstall"
      ]
    },
    "platforms": [
      "linux",
      "wsl2"
    ]
  },
  "skills": [
    {
      "name": "ux-gan-harness",
      "source": "tools/codex-ux-stack/skill",
      "assembled": false
    },
    {
      "name": "ooui-design",
      "source": "tools/codex-ux-stack/ooui-design",
      "assembled": false
    }
  ],
  "sources": [
    {
      "url": "https://github.com/vercel-labs/agent-skills",
      "revision": "063bee94c3f4df8453406c830b0a7df0f2860278"
    },
    {
      "url": "https://github.com/Thecsiz/ux-critique",
      "revision": "3da293cafb639195bf71797590081d4ffb0045ba (optional deep install)"
    }
  ],
  "dependencies": [
    {
      "name": "Node.js >=20",
      "condition": "when this kit/feature is selected"
    },
    {
      "name": "pinned Playwright/browser MCP runtime",
      "condition": "when this kit/feature is selected"
    },
    {
      "name": "Codex vendor plugins (Codex only)",
      "condition": "legacy Codex install only; optional existing vendor integrations in the additional Codex path; not installed for Claude"
    },
    {
      "name": "Node.js >=24, @microsoft/mxc-sdk==1.0.0",
      "condition": "Claude experiment execution only"
    }

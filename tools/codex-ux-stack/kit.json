  "destinations": [
    "{skills_home}/ux-gan-harness",
    "{skills_home}/ooui-design",
    "{agent_home}/ux-stack/runtime"
  ],
  "settings": [
    "selected plugins and MCP configuration; owned CLI launchers"
  ],
  "plugin": {
    "name": "ux-stack",
    "enabled": true,
    "codex": "optional",
    "claude": "experimental",
    "runtime": "intelliforge kit-run ux-stack",
    "notes": "Additional path uses the pinned local Playwright browser; vendor plugins and optional deep critique are not automatically installed."
  },
  "editable_sources": [
    "tools/codex-ux-stack"
  ],
  "compatibility": "Legacy behavior unchanged. Plugin/portable installs are a separate opt-in path.",
  "package_version": "0.1.0",
  "version_kind": "local kit version; upstream versions are resolved and recorded separately"
}

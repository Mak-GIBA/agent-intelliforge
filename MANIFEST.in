include install_*.sh install_*.ps1 intelliforge.py
recursive-include tools *
recursive-include plugins *
recursive-include .agents *.json
recursive-include .claude-plugin *.json
recursive-include scripts *.py
include docs/research-archives.json docs/research-archives.md docs/en/research-archives.md
# Historical writing records are distributed separately, even if restored locally.
prune tools/kotonoha/evaluation*
global-exclude *.pyc *.private.json
